 generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model Faction {
  id          Int      @id @default(autoincrement())
  name        String   @unique // örn. "Mavi "
  color       String   // örn. "#0000FF"
  users       User[]
  hexesOwned  Int      @default(0)
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  username       String    @unique
  password       String
  faction        Faction   @relation(fields: [factionId], references: [id])
  factionId      Int
  totalPoints    Int       @default(0)
  level          Int       @default(1)
  profilePicture String?
  reviews        Review[]
  createdAt      DateTime  @default(now())
}

model Venue {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   // örn. "Kafe", "Kütüphane"
  address     String?
  
  // Uber H3 İndeksi 
  h3Index     String   // Çözünürlük 7 veya 8'deki Altıgen Kimliği
  
  // PostGIS Noktası - Konumsal sorgular için Enlem/Boylam bilgisini geometri olarak kaydetme
  location    Unsupported("geometry(Point, 4326)") 
  
  reviews     Review[]

  @@index([h3Index])
}

model Review {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  venue     Venue    @relation(fields: [venueId], references: [id])
  venueId   Int
  rating    Int      @default(5)
  content   String?
  createdAt DateTime @default(now())
}